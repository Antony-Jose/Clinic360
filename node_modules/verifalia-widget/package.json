{
	"name": "verifalia-widget",
	"version": "1.13.0",
	"description": "A lightweight JavaScript widget with zero dependencies that performs real-time email address validation using the Verifalia email verification service. This widget integrates seamlessly with any web form to swiftly identify and eliminate invalid, undeliverable, and unwanted email addresses, including disposable, spam trap, and free emails.",
	"main": "dist/verifalia-widget.js",
	"scripts": {
		"build:genversion": "genversion --es6 src/version.ts",
		"build": "npm run build:genversion && rollup -c && node update-readme.js",
		"build:production": "cross-env NODE_ENV=production npm run build",
		"lint": "tslint",
		"build:tsc": "tsc",
		"pack-preview": "npm pack && tar -xvzf *.tgz && rm -rf package *.tgz",
		"check-readme-links": "docker run -v ${PWD}:/tmp:ro --rm -i ghcr.io/tcort/markdown-link-check:stable /tmp/README.md",
		"test": "npx playwright test"
	},
	"keywords": [
		"email",
		"validation",
		"verification",
		"free",
		"verifalia",
		"service",
		"list",
		"cleaning",
		"scrubbing",
		"e-mail",
		"syntax",
		"smtp",
		"disposable",
		"mailbox",
		"throw-away",
		"catch-all",
		"email checker",
		"email verifier",
		"email validation",
		"email verification",
		"email tester",
		"temporary email",
		"bot detection",
		"captcha",
		"verify email",
		"check email",
		"validate email",
		"deliverability",
		"deliverable email",
		"bounce remover"
	],
	"author": "Verifalia <support@verifalia.com> (https://verifalia.com)",
	"contributors": [
		{
			"name": "Verifalia",
			"email": "support@verifalia.com",
			"url": "https://verifalia.com"
		},
		{
			"name": "Efran Cobisi"
		},
		{
			"name": "Teno Basabanchi"
		},
		{
			"name": "Bruno Liegi Bastonliegi"
		}
	],
	"bugs": "https://verifalia.com/support/contact-us",
	"license": "MIT",
	"devDependencies": {
		"@playwright/test": "1.42.1",
		"@types/chai": "^4.3.5",
		"@types/debug": "^4.1.5",
		"@types/jquery": "^3.3.38",
		"@types/mocha": "^10.0.1",
		"@types/node": "^14.0.5",
		"cross-env": "^7.0.2",
		"cssnano": "^4.1.10",
		"dotenv": "^16.4.5",
		"dts-bundle-generator": "^4.3.0",
		"express": "^4.18.3",
		"genversion": "^2.2.1",
		"mdn-polyfills": "^5.20.0",
		"node-gyp": "^10.0.1",
		"node-sass": "^9.0.0",
		"postcss-cssnext": "^3.1.0",
		"replace-in-file": "^6.0.0",
		"rollup": "^1.32.1",
		"rollup-plugin-banner": "^0.2.1",
		"rollup-plugin-commonjs": "^10.0.2",
		"rollup-plugin-json": "^4.0.0",
		"rollup-plugin-node-builtins": "^2.1.2",
		"rollup-plugin-node-globals": "^1.4.0",
		"rollup-plugin-node-resolve": "^5.2.0",
		"rollup-plugin-postcss": "^3.1.1",
		"rollup-plugin-replace": "^2.2.0",
		"rollup-plugin-terser": "^5.3.1",
		"rollup-plugin-typescript2": "^0.27.3",
		"rollup-plugin-uglify": "^6.0.4",
		"rollup-plugin-visualizer": "^4.0.4",
		"ssri": "^8.0.0",
		"ts-loader": "^7.0.5",
		"tslint": "^6.1.2",
		"typescript": "^3.9.3",
		"verifalia": "^5.0.0"
	},
	"overrides": {
		"prebuild": {
			"node-gyp": "$node-gyp"
		}
	},
	"files": [
		"dist/**/*",
		"docs/**/*"
	]
}
